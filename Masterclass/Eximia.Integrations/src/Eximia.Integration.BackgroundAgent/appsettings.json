{
  "AllowedHosts": "*",
  "LogSwitch": "Information",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Silverback": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [
      "WithMachineName"
    ],
    "Properties": {
      "ApplicationName": "Integration-API"
    }
  },
  "DatabaseConnection": {
    "Host": "localhost",
    "Port": 5432,
    "User": "postgres",
    "Password": "postgres",
    "DatabaseName": "integration_tests",
    "DisableSsl": true,
    "Pooling": true,
    "MaxPoolSize": 10,
    "MinPoolSize": 0,
    "Timeout": 15,
    "ConnectionIdleLifetime": 300,
    "Multiplexing": false
  },
  "Kafka": {
    "Connection": {
      "GroupId": "local-dev",
      "BootstrapServers": "PLAINTEXT://localhost:29092",
      "SecurityProtocol": 0,
      "Username": "",
      "Password": "",
      "TopicError": "error"
    },
    "Events": {
      "Topic": "operations-panel-events",
      "AutoOffsetReset": 1
    }
  },
  "Auth": {
    "Uri": "",
    "Scope": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "IntegrationApiUrl": "",
  "RouteAuthentication": [
    {
      "Destiny": "SAP",
      "Type": "client_credentials",
      "Client": "",
      "Secret": "",
      "Uri": "",
      "Scope": ""
    }
  ]
}