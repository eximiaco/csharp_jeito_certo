{
  "AllowedHosts": "*",
  "LogSwitch": "Information",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Silverback": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "WithMachineName"
    ],
    "Properties": {
      "ApplicationName": "Integration-API"
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "example.onmicrosoft.com",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "Audience": "00000000-0000-0000-0000-000000000000"
  },
  "Kafka": {
    "Connection": {
      "GroupId" : "local-dev",
      "BootstrapServers" : "PLAINTEXT://localhost:29092",
      "SecurityProtocol" : 0,
      "Username": "",
      "Password": "",
      "TopicError":  "error"
    },
    "Consumer": {
      "Inbounds" : []
    }
  },
  "DatabaseConnection": {
    "Host": "localhost",
    "Port": 5432,
    "User": "postgres",
    "Password": "postgres",
    "DatabaseName": "integration_tests",
    "DisableSsl": true,
    "Pooling": true,
    "MaxPoolSize": 10,
    "MinPoolSize": 0,
    "Timeout": 15,
    "ConnectionIdleLifetime": 300,
    "Multiplexing": false
  }
}