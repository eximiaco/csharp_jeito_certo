{
  "AllowedHosts": "*",
  "IntegrationApiUrl": "http://localhost:5000/api/integrations/callback",
  "LogSwitch": "Information",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Silverback": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "WithMachineName"
    ],
    "Properties": {
      "ApplicationName": "Event-Dispatcher"
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "example.onmicrosoft.com",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "Audience": "00000000-0000-0000-0000-000000000000"
  },
  "Auth": {
    "Uri": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/token",
    "Scope": "api://integration-api/.default",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "ClientSecret": ""
  },
  "DatabaseConnection": {
    "Host": "localhost",
    "Port": 5432,
    "User": "postgres",
    "Password": "postgres",
    "DatabaseName": "integration_tests",
    "DisableSsl": true,
    "Pooling": true,
    "MinPoolSize": 0,
    "MaxPoolSize": 10,
    "Timeout": 15,
    "ConnectionIdleLifetime": 300,
    "Multiplexing": true
  },
  "Kafka": {
    "Connection": {
      "GroupId": "local-dev",
      "BootstrapServers": "PLAINTEXT://localhost:29092",
      "SecurityProtocol": 0,
      "Username": "",
      "Password": "",
      "TopicError": "error"
    },
    "Consumer": {
      "Inbounds": [
        {
          "Topics": "teste-purchaseorder",
          "AutoOffsetReset": 1
        }
      ]
    }
  },
  "RouteAuthentication": [
    {
      "Destiny": "SAP",
      "Type": "client_credentials",
      "Client": "",
      "Secret": "",
      "Uri": "",
      "Scope": ""
    }
  ]
}